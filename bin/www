generator_units.on('message', (topic, message) => {
  if (['ps/sapele/gas', 'ps/sapele-nipp', 'ps/sapele/steam', 'ps/egbin/steam/lagos/pd'].includes(topic)) {
      // console.log(message.toString(), 'generator units');
  }
  // return;
  // broadcast the message to the client that are connected
  // Function to run when a client connects to the server whereever it is hosted

  // const payload = message.toString();
  // if (topic === 'bilateral/ikejaWest-sakate/lagos/pd') bilateralIkejaWestSakateLagosPd = payload; //-- sakete
    
  io.sockets.emit('generator_units', { message: message.toString() });
 
  let data;
  try {
    if(message[0] === '"') {
      message = '{' + message;
      message = message.replace(/.(?=\])/g, '')
    }
    data = JSON.parse(message.toString());
    // const name = data.id ? data.id : data.name;
    const genco_name = data.id ? data.id : data.name ? data.name : null;
    // if(genco_name === "egbinPs") {
    //     data.t = new Date().toLocaleTimeString("en-GB").split(' ')[0];
    //   }
    const time = data.t ? data.t : new Date().toLocaleTimeString("en-GB").split(' ')[0];
    const { lines, transformers, units } = data;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit' };
    const date = new Date().toLocaleDateString("en-GB", options).split('/').reverse().join('-');
    const hour = time.split(':')[0];
    const minute = time.split(':')[1];
    const seconds = time.split(':')[2];
    const dateTemp = date.split('-');
    const epoch_time = new Date(Number(dateTemp[0]), Number(dateTemp[1]-1), Number(dateTemp[2]), Number(hour)+1, Number(minute), Number(seconds));
    // console.log(epoch_time.getTime(), epoch_time, 'the epoch')
    let voltage, active_power, reactive_power, current, power_factor, frequency, unit_name;

    // loop over the lines or transformers array if it exists, else we deal with single units logic
    const equip = lines ? lines : transformers ? transformers : units ? units : undefined;
    if(equip) {
      equip.forEach(line => {
        unit_name = line.id;          
        voltage = line.pd?.v ? line.pd.v : line.td?.v ? line.td.v : 0.00;
        active_power = line.pd?.mw ? line.pd.mw : line.td?.mw ? line.td.mw : 0.00;
        current = line.pd?.a ? line.pd.a : line.td?.a ? line.td.a : 0.00;
        reactive_power = line.pd?.mx ? line.pd.mx : line.td?.mx ? line.td.mx : 0.00;
        power_factor = line.pd?.pf && isNaN(line.pd.pf) == false ? line.pd.pf : line.td?.pf && isNaN(line.td.pf) == false ? line.td.pf : 0.00;
        frequency = line.pd?.f && isNaN(line.pd.f) == false ? line.pd.f  : line.td?.f && isNaN(line.td.f) == false ? line.td.f : 0.00;
        // (date, hour, minute, seconds, kv, mw, mvar, amp, name, line_name, time, pf, f)
        db.query(gencosModel.create, [date, hour, minute, seconds, voltage, active_power, reactive_power, current, genco_name, unit_name, epoch_time.getTime(), power_factor, frequency])
        .then( response => {
          // console.log('its okay 2')
        })
        .catch(err => console.log(err))
      }) 
    }
  } catch(err) {
      console.error(err)
  }
 
});

