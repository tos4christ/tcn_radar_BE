  // else if (topic === 'gwagwaladats/tv') gwagwaladatsTv = payload; //-- client 2  
  // else if (topic === 'dadinkowags/tv') dadinkowagsTv = payload; //-- client 2
  // else if (topic === 'parasenergyPs/pv') parasenergyPsPv = payload;  //-- client 2  
  // else if (topic === 'asabats/tv') asabatsTv = payload; //-- client 2
  // else if (topic === 'delta4gs/tv') delta4gsTv = payload; //-- client 2
  // else if (topic === 'OkpaiippGs/tv') okpaiippGsTv = payload; //-- client 2
  // else if (topic === 'jebbaTs/tv') jebbaTsTv = payload; //-- client 2
  // else if (topic === 'kainjits/tv') kainjitsTv = payload; //-- client 2
  // else if (topic === 'egbings/pv') egbingsPv = payload; //-- client 2
  // else if (topic === 'riversIppPs/pr') riversIppPsPr = payload; //-- client 2
  // else if (topic === 'afam4gs/pv') afam4gsPv = payload; //-- client 2
  // else if (topic === 'shirorogs/pv') shirorogsPv = payload; //-- client 2
  // else if (topic === 'afam6ts/tv') afam6tsTv = payload; //-- client 2
  // else if (topic === 'delta2gs/pv') delta2gsPv = payload; //-- client 2  
  // else if (topic === 'omokugs/pv') omokugsPv = payload; //-- client 2  
  // else if (topic === 'sapelets/pv') sapeletsPv = payload; //-- client 2
  // else if (topic === 'ihovborts/tv') ihovbortsTv = payload; //-- client 2
  // else if (topic === 'odukpanits/pv') odukpanitsPv = payload; //-- client 2  
  // else if (topic === 'zungeru/tv') zungeruTv = payload;  //-- client 2
  // else if (topic === 'taopex/tv') taopexTv = payload; //-- client 2
  // else if (topic === 'ndphc/sunflag/lagos/pd') ndphcSunflagLagosPd = payload; //-- client 2  
  // else if (topic === 'ndphc/pulkit/lagos/pd') ndphcPulkitLagosPd = payload; //-- client 2
  // else if (topic === 'afl/cs') aflCs = payload; //-- client 2  
  // else if (topic === 'quantum/cs') quantumCs = payload; //-- client 2
  // else if (topic === 'starPipe/cs') starPipeCs = payload; //-- client 2  
  // else if (topic === 'ikorodu2/tv') ikorodu2Tv = payload; //-- client 2
    
  io.sockets.emit('client_message_222', { message: message.toString() });
  
  // line model data => date, hour, minute, seconds, kv, mw, mvar, amp, equipment_id, station, level, line_name, variant
  let data;
  try {
      data = JSON.parse(message.toString());     
      const station = data.id ? data.id : data.name;
      // if(station === "egbinPs") {
      //   data.t = new Date().toLocaleTimeString("en-GB").split(' ')[0];
      // }
      const time = data.t ? data.t : new Date().toLocaleTimeString("en-GB").split(' ')[0];
      const { lines, units, transformers } = data;
      var options = { year: 'numeric', month: '2-digit', day: '2-digit' };
      const date = new Date().toLocaleDateString("en-GB", options).split('/').reverse().join('-');
      const hour = time.split(':')[0];
      const minute = time.split(':')[1]
      const seconds = time.split(':')[2]
      const level = 330;
      const dateTemp = date.split('-');
      const epoch_time = new Date(Number(dateTemp[0]), Number(dateTemp[1]-1), Number(dateTemp[2]), Number(hour)+1, Number(minute), Number(seconds));
      // console.log(epoch_time.getTime(), epoch_time, 'the epoch')
      let kv, mw, mvar, amp, equipment_id, line_name, variant;
      // loop over the lines or units array
      const equip = lines ? lines : units ? units : transformers ? transformers : undefined;
      equip.forEach(line => {
          equipment_id = line.id;
          line_name = line.id;
          variant = line.td ? 'transmission' : line.gd ? 'generation' : line.pd ? 'generation_units' : undefined;
          if (variant === 'transmission') {
              kv = line.td.V ? line.td.V : line.td.v ? line.td.v : 0.00;
              mw = line.td.mw ? line.td.mw : 0.00;
              amp = line.td.A ? line.td.A : 0.00;
              mvar = line.td.mvar ? line.td.mvar : 0.00;
          } else if (variant === 'generation') {
              kv = line.gd.V ? line.gd.V : line.gd.v ? line.gd.v : 0.00;
              mw = line.gd.mw ? line.gd.mw : 0.00;
              amp = line.gd.A ? line.gd.A : 0.00;
              mvar = line.gd.mvar ? line.gd.mvar : 0.00;
          } else if (variant === 'generation_units') {
              kv = line.pd.v ? line.pd.v : 0.00;
              mw = line.pd.mw ? line.pd.mw : 0.00;
              amp = line.pd.a ? line.pd.a : 0.00;
              mvar = line.pd.mx ? line.pd.mx : 0.00;
          } else if (variant === undefined) {
              return;
          }
          db.query(linesModel.create, [date, hour, minute, seconds, kv, mw, mvar, amp, equipment_id, station, level, line_name, variant, epoch_time.getTime()])
              .then( response => {
                // console.log('its okay 2')
              })
              .catch(err => console.log(err))
      })   
  // client.end()
  } catch(err) {
      console.error(err)
  }
});
