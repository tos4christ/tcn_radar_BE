client_mesl.on('message', (topic, message) => {
  if ([
      'mesl/AENL/pd'
  ].includes(topic)) {
    // console.log(message.toString(), '  client mesl  ', topic);
  }
  // broadcast the message to the client that are connected
  // Function to run when a client connects to the server whereever it is hosted

  // const payload = message.toString();
  // if (topic === 'mesl/niamey/pd') meslNiameyPd = payload; //-- mesl
  // else if (topic === 'mesl/zeberced/pd') meslZebercedPd = payload;  //-- mesl  
  // else if (topic === 'mesl/inner-galaxy1/pd') meslInnerGalaxy1Pd = payload; //-- mesl  
  // else if (topic === 'mesl/inner-galaxy2/pd') meslInnerGalaxy2Pd = payload;  //-- mesl
  // else if (topic === 'mesl/gazaoua/pd') meslGazaouaPd = payload;  //-- mesl  
  // else if (topic === 'mesl/Kam33/pd') meslKam33Pd = payload; //-- mesl
  // else if (topic === 'mesl/PSML/pd') meslPSMLPd = payload; //-- mesl
  // else if (topic === 'mesl/ATVL/pd') meslATVLPd = payload; //-- mesl
  // else if (topic === 'quantum/cs') quantumCs = payload; //-- mesl
  // else if (topic === 'mesl/hydropolis/pd') meslHydropolisPd = payload; //-- mesl
  // else if (topic === 'mesl/yongxing/pd') meslYongxingPd = payload; //-- mesl
    
  io.sockets.emit('client_message_mesl', { message: message.toString() }); 
  
  if (['quantum/cs'].includes(topic)) {
      // Do not save this into the database, it is already being saved in Client_2
      return;
    }
 
  let data;
  try {
      data = JSON.parse(message.toString());
      // const name = data.id ? data.id : data.name;
      const name = data.name;
      const time = data.t ? data.t : new Date().toLocaleTimeString("en-GB").split(' ')[0];
      // const { lines, transformers } = data;
      var options = { year: 'numeric', month: '2-digit', day: '2-digit' };
      const date = new Date().toLocaleDateString("en-GB", options).split('/').reverse().join('-');
      const hour = time.split(':')[0];
      const minute = time.split(':')[1];
      const seconds = time.split(':')[2];
      const dateTemp = date.split('-');
      const epoch_time = new Date(Number(dateTemp[0]), Number(dateTemp[1]-1), Number(dateTemp[2]), Number(hour)+1, Number(minute), Number(seconds));
      // console.log(epoch_time.getTime(), epoch_time, 'the epoch')
      let kv, mw, mvar, amp, pf, freq, line_name=name;

      // loop over the lines or transformers array if it exists, else we deal with single units logic
      // const equip = lines ? lines : transformers ? transformers : undefined;
      if(false) {
        equip.forEach(line => {
          line_name = line.id;          
          kv = line.td.v ? line.td.v : 0.00;
          mw = line.td.mw ? line.td.mw : 0.00;
          amp = line.td.a ? line.td.a : 0.00;
          mvar = line.td.mx ? line.td.mx : 0.00;
          pf = data.pf && isNaN(data.pf) == false ? data.pf  : 0.00;
          freq = data.f && isNaN(data.f) == false ? data.f  : 0.00;
          // (date, hour, minute, seconds, kv, mw, mvar, amp, name, line_name, time, pf, f)
          db.query(bilateralModel.create, [date, hour, minute, seconds, kv, mw, mvar, amp, name, line_name, epoch_time.getTime(), pf, freq])
          .then( response => {
            // console.log('its okay 2')
          })
          .catch(err => console.log(err))
        }) 
      } else {
        kv = data.v ? data.v : 0.00;
        mw = data.mw ? data.mw : 0.00;
        amp = data.a ? data.a : 0.00;
        mvar = data.mx ? data.mx : 0.00;
        pf = data.pf && isNaN(data.pf) == false ? data.pf  : 0.00;
        freq = data.f && isNaN(data.f) == false ? data.f  : 0.00;
        // (date, hour, minute, seconds, kv, mw, mvar, amp, name, line_name, time, pf, f)
        db.query(bilateralModel.create, [date, hour, minute, seconds, kv, mw, mvar, amp, name, line_name, epoch_time.getTime(), pf, freq])
        .then( response => {
          // console.log('its okay 2')
        })
        .catch(err => console.log(err));
      } 
  } catch(err) {
      console.error(err)
  }
});
